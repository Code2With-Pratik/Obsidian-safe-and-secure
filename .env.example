# Copy this file to `.env.local` and fill in your own credentials. Never
# commit `.env.local` (it's gitignored).

# Klipy API key — powers the chat composer's GIF, Sticker, and Meme tabs.
# Sign up for a key at https://klipy.com — the code falls back to a bundled
# default key if this is empty, so you only need to override for production.
KLIPY_API_KEY=

# Supabase — create a project at https://supabase.com and copy the values
# from Project Settings → API.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Supabase secret key (server-side only — NEVER expose to the browser).
# From Project Settings → API → "Secret keys" → reveal + copy the default
# `sb_secret_...` value. Used by lib/supabase/actions.ts signup() to call
# the Admin API with `email_confirm: true`, so new accounts are created
# pre-confirmed and no verification email is sent. Do NOT add a
# NEXT_PUBLIC_ prefix — that would leak the key to the browser bundle.
SUPABASE_SECRET_KEY=

# Public site URL — used to build absolute links inside server actions
# (email confirmation, password reset). Set this to your deployed origin
# WITHOUT a trailing slash:
#   • Local dev:   http://localhost:3000
#   • Render:      https://obsidian-safe-and-secure.onrender.com
#   • Vercel:      your-app.vercel.app  (https:// added automatically)
# If you don't set this, signup confirmation links default to localhost
# which breaks every prod deployment that forgets to update it.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# LiveKit — powers the voice + video call experience on /calls/active.
# Create a project at https://cloud.livekit.io and paste the credentials below.
# LIVEKIT_URL / LIVEKIT_API_KEY / LIVEKIT_API_SECRET are server-side only.
# NEXT_PUBLIC_LIVEKIT_URL is the same wss URL, exposed to the browser.
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
NEXT_PUBLIC_LIVEKIT_URL=

# Obsidian AI — server-side Gemini key drives reasoning + tool-calling.
# Gemini exposes an OpenAI-compatible endpoint so we keep the `openai` SDK
# and just point its baseURL at Google. Get a free key from
# https://aistudio.google.com/apikey — the free tier handles tool-calling on
# `gemini-2.5-flash` and `gemini-2.0-flash` (15 requests/min, 1500/day).
GEMINI_API_KEY=
# `gemini-2.5-flash-lite` is the recommended free-tier default — 15 RPM and
# the highest daily quota (1000 requests/day vs ~200 on the other flash
# tiers), 2.5-generation reasoning, and full tool-calling. Upgrade to
# `gemini-2.5-flash` or `gemini-2.0-flash` for higher quality if you have
# a paid plan.
NEXT_PUBLIC_AI_MODEL=gemini-2.5-flash-lite

# ElevenLabs — server-side TTS for the assistant's voice replies.
# Get a key at https://elevenlabs.io/app/settings/api-keys.
#
# IMPORTANT for FREE-tier accounts: ElevenLabs blocks API access to
# "library voices" (community-shared / cloned voices) on the free plan.
# Use a PREMADE voice id (ships built into every account) — these all
# work on the free tier:
#   21m00Tcm4TlvDq8ikWAM  Rachel    (en-US female, default)
#   EXAVITQu4vr4xnSDxMaL  Sarah     (en-US female)
#   AZnzlk1XvdvUeBnXmlld  Domi      (en-US female, expressive)
#   TxGEqnHWrfWFTfGW9XjX  Josh      (en-US male)
#   pNInz6obpgDQGcFmaJgB  Adam      (en-US male, deeper)
#   yoZ06aMxZJJ28mfd3POQ  Sam       (en-US male, narration)
#   XB0fDUnXU5powFXDhCwa  Charlotte (en-GB female)
# Cloned voices YOU own work too. The "eleven_turbo_v2_5" model is the
# fastest streaming-capable tier and supports every voice above.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM
ELEVENLABS_MODEL_ID=eleven_turbo_v2_5
